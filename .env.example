POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_only
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
# Optional video integration. Generate local secrets with:
# cd backend && uv run python -m crm.modules.video_calls.configure
CRM_VIDEO_ENABLED=false
CRM_LIVEKIT_URL=http://livekit:7880
CRM_LIVEKIT_PUBLIC_URL=ws://localhost:7880
CRM_LIVEKIT_API_KEY=
CRM_LIVEKIT_API_SECRET=
CRM_FRONTEND_URL=http://localhost:3000
CRM_SESSION_COOKIE_SECURE=false
# Optional bootstrap helper: generate a random password with crm.modules.auth.configure.
CRM_BOOTSTRAP_MANAGER_ID=1
CRM_BOOTSTRAP_LOGIN=manager1
CRM_BOOTSTRAP_PASSWORD=
# HTTPS override defaults to localhost; public hosting needs your domains and DNS.
CRM_HTTPS_FRONTEND_URL=https://localhost:8443
CRM_HTTPS_LIVEKIT_PUBLIC_URL=wss://localhost:8444
